# Server-only Viator Partner API credential.
# Never prefix this variable with NEXT_PUBLIC_.
VIATOR_API_KEY=replace_with_your_viator_api_key

# Optional. The app defaults to the production Viator Partner API.
# Use https://api.sandbox.viator.com/partner for sandbox testing.
VIATOR_API_ROOT=https://api.viator.com/partner

# Optional affiliate query string added to outbound Viator links.
# This value is visible in the browser by design; do not put secrets here.
NEXT_PUBLIC_VIATOR_AFFILIATE_SUFFIX=replace_with_your_affiliate_query_string
